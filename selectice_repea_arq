
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, window, i;

    printf("Enter total number of frames: ");
    scanf("%d", &n);

    printf("Enter window size: ");
    scanf("%d", &window);

    int ack[n];

    for(i = 0; i < n; i++)
        ack[i] = 0;

    printf("\n--- Selective Repeat ARQ ---\n");

    for(i = 0; i < n; i += window) {

        printf("\nSending frames:\n");

        for(int j = i; j < i + window && j < n; j++) {
            printf("Frame %d sent\n", j + 1);
        }

        printf("\nEnter frame number to simulate loss (0 for none): ");
        int lost;
        scanf("%d", &lost);

        for(int j = i; j < i + window && j < n; j++) {

            if(j + 1 == lost) {
                printf("Frame %d lost! No ACK received.\n", j + 1);
            }
            else {
                printf("Frame %d received. ACK received.\n", j + 1);
                ack[j] = 1;
            }
        }

        // Retransmit only lost frames
        for(int j = i; j < i + window && j < n; j++) {

            if(ack[j] == 0) {
                printf("\nRetransmitting Frame %d\n", j + 1);
                printf("Frame %d received successfully. ACK received.\n", j + 1);
                ack[j] = 1;
            }
        }
    }

    printf("\nAll frames transmitted successfully!\n");

    return 0;
}
