
#include <iostream>
using namespace std;

#define INF 999

int main() {
    int r, cost[10][10];
    int dist[10], visited[10];
    int src, min, u;

    cout << "Enter number of routers: ";
    cin >> r;

    cout << "Enter cost matrix:\n";

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < r; j++) {
            cin >> cost[i][j];
        }
    }

    cout << "Enter source router: ";
    cin >> src;
    src--;

    // Initialize distance and visited arrays
    for(int i = 0; i < r; i++) {
        dist[i] = cost[src][i];
        visited[i] = 0;
    }

    dist[src] = 0;
    visited[src] = 1;

    // Dijkstra's Algorithm
    for(int count = 1; count < r; count++) {
        min = INF;
        u = -1;

        for(int i = 0; i < r; i++) {
            if(!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        if(u == -1)
            break;

        visited[u] = 1;

        for(int v = 0; v < r; v++) {
            if(!visited[v] && cost[u][v] != INF &&
               dist[u] + cost[u][v] < dist[v]) {
                dist[v] = dist[u] + cost[u][v];
            }
        }
    }

    // Print final routing table
    cout << "\nFinal Routing Table\n";

    for(int i = 0; i < r; i++) {
        cout << "\nRouter " << src + 1 << " to Router "
             << i + 1 << " = " << dist[i];
    }

    return 0;
}
