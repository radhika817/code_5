#include <stdio.h>
#include <string.h>

void xor_div(char *data, const char *gen)  //Modulo-2 Division
 {
    int glen = strlen(gen), dlen = strlen(data) - glen + 1;
    for (int i = 0; i < dlen; i++) {
        if (data[i] == '1') {
            for (int j = 0; j < glen; j++)
                data[i + j] = (data[i + j] == gen[j]) ? '0' : '1';
        }
    }
}

int main() {
    char msg[64], gen[16], frame[128], rem[128];
    printf("Enter data : "); scanf("%s", msg);
    printf("Enter generator( Shared Key): "); scanf("%s", gen);

    int mlen = strlen(msg), glen = strlen(gen);

    // Append (glen - 1) zeros
    strcpy(frame, msg);
    for (int i = 0; i < glen - 1; i++) frame[mlen + i] = '0';
    frame[mlen + glen - 1] = '\0';

    // Compute remainder
    strcpy(rem, frame);
    xor_div(rem, gen);

    // Replace trailing zeros with remainder
    for (int i = 0; i < glen - 1; i++) frame[mlen + i] = rem[mlen + i];
    printf("Transmitted frame: %s\n", frame);

    // Verification at receiver
    printf("Enter received frame: "); scanf("%s", rem);
    xor_div(rem, gen);

    int error = 0;
    for (int i = strlen(rem) - (glen - 1); rem[i]; i++)
        if (rem[i] == '1') error = 1;

    printf(error ? "Status: Error detected!\n" : "Status: Frame is valid.\n");
    return 0;
}


#include <stdio.h>
#include <string.h>

int main() {
    char data[100], gen[30], temp[130], rem[30];
    int i, j, dlen, glen;

    printf("Enter data bits: ");
    scanf("%s", data);

    printf("Enter generator bits: ");
    scanf("%s", gen);

    dlen = strlen(data);
    glen = strlen(gen);

    // Append zeros to data
    strcpy(temp, data);

    for (i = 0; i < glen - 1; i++)
        temp[dlen + i] = '0';

    temp[dlen + glen - 1] = '\0';

    // CRC division using XOR
    for (i = 0; i < dlen; i++) {
        if (temp[i] == '1') {
            for (j = 0; j < glen; j++) {
                temp[i + j] =
                    (temp[i + j] == gen[j]) ? '0' : '1';
            }
        }
    }

    // Get CRC remainder
    printf("\nCRC remainder: ");
    for (i = dlen; i < dlen + glen - 1; i++) {
        rem[i - dlen] = temp[i];
        printf("%c", rem[i - dlen]);
    }

    rem[glen - 1] = '\0';

    // Generate transmitted codeword
    printf("\nTransmitted data: %s%s\n", data, rem);

    // Receive data
    printf("\nEnter received data: ");
    scanf("%s", temp);

    // Check received data
    int len = strlen(temp);

    for (i = 0; i <= len - glen; i++) {
        if (temp[i] == '1') {
            for (j = 0; j < glen; j++) {
                temp[i + j] =
                    (temp[i + j] == gen[j]) ? '0' : '1';
            }
        }
    }

    // Check remainder
    int error = 0;

    for (i = len - glen + 1; i < len; i++) {
        if (temp[i] != '0')
            error = 1;
    }

    if (error == 0)
        printf("No error detected!\n");
    else
        printf("Error detected!\n");

    return 0;
}
