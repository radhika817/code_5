
#include <stdio.h>

#define INF 999

int main() {
    int r, cost[10][10];
    int dist[10], visited[10];
    int src, min, u;

    printf("Enter number of routers: ");
    scanf("%d", &r);

    printf("Enter cost matrix:\n");

    for(int i = 0; i < r; i++) {
        for(int j = 0; j < r; j++) {
            scanf("%d", &cost[i][j]);
        }
    }

    printf("Enter source router: ");
    scanf("%d", &src);
    src--;

    // Initialize distance and visited arrays
    for(int i = 0; i < r; i++) {
        dist[i] = cost[src][i];
        visited[i] = 0;
    }

    dist[src] = 0;
    visited[src] = 1;

    // Dijkstra's Algorithm
    for(int count = 1; count < r; count++) {
        min = INF;
        u = -1;

        for(int i = 0; i < r; i++) {
            if(!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        if(u == -1)
            break;

        visited[u] = 1;

        for(int v = 0; v < r; v++) {
            if(!visited[v] && cost[u][v] != INF &&
               dist[u] + cost[u][v] < dist[v]) {
                dist[v] = dist[u] + cost[u][v];
            }
        }
    }

    // Print final routing table
    printf("\nFinal Routing Table\n");

    for(int i = 0; i < r; i++) {
        printf("Router %d to Router %d = %d\n",
               src + 1, i + 1, dist[i]);
    }

    return 0;
}
