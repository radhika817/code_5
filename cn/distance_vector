
#include <stdio.h>

#define INF 999

int main() {
    int n, cost[10][10], dist[10][10];

    printf("Enter number of routers: ");
    scanf("%d", &n);

    printf("Enter cost matrix (999 for no connection):\n");

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);
            dist[i][j] = cost[i][j];
        }
    }

    // Distance Vector Algorithm
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (dist[i][j] > cost[i][k] + dist[k][j]) {
                    dist[i][j] = cost[i][k] + dist[k][j];
                }

            }
        }
    }

    printf("\nFinal Routing Table:\n");

    for (int i = 0; i < n; i++) {
        printf("\nRouter %d:\n", i + 1);

        for (int j = 0; j < n; j++) {
            printf("To Router %d = %d\n", j + 1, dist[i][j]);
        }
    }

    return 0;
}
